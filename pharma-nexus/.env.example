# ============================================
# Pharma Nexus — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# --- PostgreSQL ---
POSTGRES_USER=pharma_nexus
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=pharma_nexus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pharma_nexus:change_me_in_production@postgres:5432/pharma_nexus
DATABASE_URL_SYNC=postgresql+psycopg2://pharma_nexus:change_me_in_production@postgres:5432/pharma_nexus

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production

# --- Claude API ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Cost mode: economy (Haiku, ~$0.01/hyp), standard (Sonnet/Opus), premium (Opus)
LLM_COST_MODE=economy

# --- NCBI / PubMed ---
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change_me_in_production

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Pharma Nexus

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
