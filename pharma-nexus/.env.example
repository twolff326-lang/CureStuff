# Pharma Nexus — Environment Configuration
# No .env file needed for default docker compose setup.
# Only create .env if you need to override these defaults.

POSTGRES_USER=pharma_nexus
POSTGRES_PASSWORD=pharma_nexus
POSTGRES_DB=pharma_nexus
DATABASE_URL=postgresql+asyncpg://pharma_nexus:pharma_nexus@postgres:5432/pharma_nexus
DATABASE_URL_SYNC=postgresql+psycopg2://pharma_nexus:pharma_nexus@postgres:5432/pharma_nexus
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_DEBUG=true
